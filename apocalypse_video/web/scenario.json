{
  "duration": 60.0,
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "lines": [
    {
      "id": "act1_00_00",
      "start": 0.0,
      "window": 3.0,
      "text": "Во всём городе погас свет.",
      "whisper": false
    },
    {
      "id": "act1_00_03",
      "start": 3.0,
      "window": 5.0,
      "text": "Связь пропала. Интернет не работает.",
      "whisper": false
    },
    {
      "id": "act1_00_08",
      "start": 8.0,
      "window": 4.0,
      "text": "Ты — один из немногих, кто ещё жив.",
      "whisper": false
    },
    {
      "id": "act2_00_12",
      "start": 12.0,
      "window": 3.0,
      "text": "Правило первое. Не включай свет. Тебя увидят.",
      "whisper": false
    },
    {
      "id": "act2_00_15",
      "start": 15.0,
      "window": 3.0,
      "text": "Правило второе. Найди оружие.",
      "whisper": false
    },
    {
      "id": "act2_00_18",
      "start": 18.0,
      "window": 4.0,
      "text": "Правило третье. Собери воду и еду. Не больше, чем унесёшь.",
      "whisper": false
    },
    {
      "id": "act2_00_22",
      "start": 22.0,
      "window": 4.0,
      "text": "Правило четвёртое. Забаррикадируй дверь. Не открывай никому.",
      "whisper": false
    },
    {
      "id": "act2_00_26",
      "start": 26.0,
      "window": 4.0,
      "text": "Правило пятое. Слушай. Они издают звук.",
      "whisper": false
    },
    {
      "id": "act2_00_30",
      "start": 30.0,
      "window": 5.0,
      "text": "Правило шестое. Когда всё сделано — не выходи. Жди рассвета. Он сделал всё правильно.",
      "whisper": false
    },
    {
      "id": "act3_00_35",
      "start": 35.0,
      "window": 3.0,
      "text": "Я же не включал…",
      "whisper": true
    },
    {
      "id": "act3_00_38",
      "start": 38.0,
      "window": 4.0,
      "text": "Они выходят.",
      "whisper": false
    },
    {
      "id": "act3_00_42",
      "start": 42.0,
      "window": 5.0,
      "text": "Беги. Не оглядывайся.",
      "whisper": false
    },
    {
      "id": "act3_00_47",
      "start": 47.0,
      "window": 5.0,
      "text": "Их — тысячи.",
      "whisper": false
    },
    {
      "id": "act4_00_52",
      "start": 52.0,
      "window": 6.0,
      "text": "Что будет дальше — решаешь ты.",
      "whisper": false
    },
    {
      "id": "act4_00_58",
      "start": 58.0,
      "window": 2.0,
      "text": "Часть вторая. Скоро. Подпишись, чтобы не пропустить.",
      "whisper": false
    }
  ],
  "subtitles": [
    {
      "start": 0.0,
      "end": 3.0,
      "text": "ВО ВСЁМ ГОРОДЕ ПОГАС СВЕТ"
    },
    {
      "start": 3.0,
      "end": 8.0,
      "text": "Связь пропала.\nИнтернет не работает."
    },
    {
      "start": 8.0,
      "end": 12.0,
      "text": "Ты — один из немногих,\nкто ещё жив."
    },
    {
      "start": 12.0,
      "end": 15.0,
      "text": "Правило первое.\nНе включай свет. Тебя увидят."
    },
    {
      "start": 15.0,
      "end": 18.0,
      "text": "Правило второе.\nНайди оружие."
    },
    {
      "start": 18.0,
      "end": 22.0,
      "text": "Правило третье.\nСобери воду и еду.\nНе больше, чем унесёшь."
    },
    {
      "start": 22.0,
      "end": 26.0,
      "text": "Правило четвёртое.\nЗабаррикадируй дверь.\nНе открывай никому."
    },
    {
      "start": 26.0,
      "end": 30.0,
      "text": "Правило пятое.\nСлушай. Они издают звук."
    },
    {
      "start": 30.0,
      "end": 35.0,
      "text": "Правило шестое.\nКогда всё сделано — не выходи.\nЖди рассвета."
    },
    {
      "start": 35.0,
      "end": 38.0,
      "text": "«Я же не включал…»"
    },
    {
      "start": 38.0,
      "end": 42.0,
      "text": "Они выходят."
    },
    {
      "start": 42.0,
      "end": 47.0,
      "text": "Беги. Не оглядывайся."
    },
    {
      "start": 47.0,
      "end": 52.0,
      "text": "Их — тысячи."
    },
    {
      "start": 52.0,
      "end": 58.0,
      "text": "Что будет дальше —\nрешаешь ты."
    },
    {
      "start": 58.0,
      "end": 60.0,
      "text": "ЧАСТЬ ВТОРАЯ. СКОРО.\nПодпишись, чтобы не пропустить."
    }
  ]
